# Ligne à changer: preprod / prod

include: "/views/Source/suivi_evo_historization_silver.view.lkml"

explore: suivi_evo_historization_silver {
  from: suivi_evo_historization_silver
  view_name: suivi_evo_historization_silver
  label: "Suivi EVO — Weekly Tracking (Silver)"

  join: suivi_evo_historization_silver__vies_requesting_teams {
    view_label: "Vies Requesting Teams"
    sql: LEFT JOIN UNNEST(${suivi_evo_historization_silver.vies_requesting_teams}) as suivi_evo_historization_silver__vies_requesting_teams ;;
    relationship: one_to_many
  }

  join: suivi_evo_historization_silver__vies_component_names {
    view_label: "Vies Component Names"
    sql: LEFT JOIN UNNEST(${suivi_evo_historization_silver.vies_component_names}) as suivi_evo_historization_silver__vies_component_names ;;
    relationship: one_to_many
  }

  join: suivi_evo_historization_silver__capitams_component_names {
    view_label: "Capitams Component Names"
    sql: LEFT JOIN UNNEST(${suivi_evo_historization_silver.capitams_component_names}) as suivi_evo_historization_silver__capitams_component_names ;;
    relationship: one_to_many
  }
}
